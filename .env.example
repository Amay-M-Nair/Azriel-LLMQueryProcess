# Copy this file to `.env` and fill in what you use. `.env` is git-ignored;
# this file is not, so never put a real value here.
# Which model answers is set by PROVIDER in server/utils/config.py (default: groq).

# Groq - answers questions (gpt-oss-120b / gpt-oss-20b).  Get one at:
#   https://console.groq.com/keys
GROQ_API_KEY=

# AWS Bedrock API key - the evaluation judge (DeepSeek).  Bedrock console ->
# API keys, region us-east-1.
AWS_BEARER_TOKEN_BEDROCK=

# SEC EDGAR asks every automated client to identify itself with a name and a
# contact email.  Requests without one are refused.
#   https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Neon Postgres (pgvector).  Neon console -> Connect, with "Connection pooling"
# switched off (migrations need a direct connection).
#   DATABASE_URL       the live index: the `production` branch
#   TEST_DATABASE_URL  the `test` branch - the only one tests ever touch
DATABASE_URL=
TEST_DATABASE_URL=

# Ollama needs no key - install it and run `ollama pull llama3.2:3b`.
